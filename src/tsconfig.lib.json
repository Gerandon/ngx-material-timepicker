{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../out-tsc/lib",
        "types": [],
        "strictPropertyInitialization": false,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "app/material-timepicker/**/*.ts",
        "app/**/*.d.ts"
    ],
    "exclude": [
        "test.ts",
        "main.ts",
        "polyfills.ts",
        "**/*.spec.ts"
    ],
    "angularCompilerOptions": {
        "compilationMode": "partial"
    }
}
